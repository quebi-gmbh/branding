{
  "name": "quebi-branding",
  "version": "1.0.0",
  "description": "quebi brand assets — source SVGs, build pipeline, release bundles.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:clean": "node scripts/build.mjs --clean",
    "package": "node scripts/build.mjs --clean && node scripts/package.mjs",
    "test": "node scripts/test.mjs",
    "verify": "pnpm run build:clean && node scripts/package.mjs && node scripts/test.mjs"
  },
  "keywords": ["quebi", "branding", "logo"],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^8.0.0",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2"
  }
}
